# Comma-separated frontend origins. Use a specific production origin when deploying.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_API_DOCS=false

# OpenAI-compatible provider used with the user's request-scoped key.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20

# Anonymous in-memory session limits. Nothing here stores user keys or chat data.
ANONYMOUS_SESSION_TTL_SECONDS=3600
MAX_ACTIVE_SESSIONS=1000
MAX_SESSION_CREATIONS_PER_MINUTE=120
MAX_MESSAGES_PER_SESSION=100
MAX_HISTORY_MESSAGES=20
