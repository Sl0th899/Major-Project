# Comma-separated frontend origins. Use a specific production origin when deploying.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set to false only when the frontend and API are on separate public domains.
ALLOW_CREDENTIALS=true

# SQLite file used by the backend.
DATABASE_PATH=cat_therapist.db

# Optional OpenAI-compatible chat provider. Chat returns 503 until this is configured.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
TOKEN_TTL_HOURS=24
